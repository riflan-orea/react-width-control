{
  "name": "react-width-control",
  "version": "1.1.4",
  "description": "Lightweight React components for min/max width constraints and single/multi-line text truncation with ellipsis. TypeScript, React 17–19.",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "test:compat": "node scripts/compat-test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "component",
    "minwidth",
    "maxwidth",
    "width",
    "control",
    "react-width-control",
    "truncate",
    "ellipsis",
    "text-truncate",
    "line-clamp",
    "multiline",
    "responsive",
    "typescript",
    "react-component"
  ],
  "author": "Riflan Ahamed",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/riflan-orea/react-width-control.git"
  },
  "bugs": {
    "url": "https://github.com/riflan-orea/react-width-control/issues"
  },
  "homepage": "https://github.com/riflan-orea/react-width-control#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.1 || ^19.1.2 || ^19.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "rollup": "^4.67.5",
    "rollup-plugin-typescript2": "^0.37.0",
    "typescript": "~6.0.3"
  }
}
